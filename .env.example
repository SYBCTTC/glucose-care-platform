# ---------- 数据库 ----------
DATABASE_URL="postgresql://gc:gc_dev_password@127.0.0.1:5432/glucose_care?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# ---------- 后端 ----------
NODE_ENV=development
SERVER_PORT=3000
# 至少 32 位随机字符串；生产环境由运维注入，禁止入库
JWT_SECRET="please-change-this-to-a-32-bytes-random-string"
JWT_EXPIRES_IN="30m"
# 敏感字段加密密钥（AES-256 / 或国密 SM4），32 字节
FIELD_ENCRYPTION_KEY="please-change-this-32-bytes-key-0001"

# ---------- 审计与合规 ----------
AUDIT_LOG_RETENTION_DAYS=180
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# 仅内网/离线环境需要：手动放置 Prisma 引擎后指定路径，可跳过引擎下载
# PRISMA_QUERY_ENGINE_LIBRARY="/abs/path/node_modules/@prisma/engines/query_engine-windows.dll.node"
# PRISMA_SCHEMA_ENGINE_BINARY="/abs/path/node_modules/@prisma/engines/schema-engine-windows.exe"

# ---------- 前端 ----------
VITE_API_BASE_URL="http://127.0.0.1:3000/api"
VITE_APP_TITLE="血糖数据与设备管理平台"
