# 统一换行符：仓库内一律 LF，避免 Windows/Linux 协作产生全文件 diff
* text=auto eol=lf

# Windows 脚本保留 CRLF，否则 cmd/PowerShell 可能执行异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须 LF
*.sh text eol=lf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.xlsx binary
*.docx binary
*.zip binary
