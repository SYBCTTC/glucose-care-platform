# pnpm 配置
strict-peer-dependencies=false
auto-install-peers=true

# Prisma 的 postinstall（下载 query engine）在 pnpm 默认隔离式 node_modules 下
# 会报 "Cannot find module '@prisma/debug'"。改为 hoisted 布局（等同 npm 扁平结构）
# 可稳定解决，内网私服场景下同样适用。
node-linker=hoisted

# 内网离线交付时可切换为院内私服，例如：
# registry=http://npm.hospital.local/repository/npm/
