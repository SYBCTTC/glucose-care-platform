// ============================================================
// 设备与人员管理平台 —— 数据库 Schema（唯一事实来源）
// 约定：
//   1. 敏感个人信息（姓名/证件/手机号）加密存储（Cipher），
//      同一字段另存脱敏值（Masked）用于列表展示。
//   2. 患者数据不做物理删除，采用归档（archivedAt）。
//   3. AuditLog 为只增表，禁止 UPDATE / DELETE（通过回收 DB 权限实现）。
//   4. 审计日志留存 ≥180 天，满足等保三级追溯要求。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------- 组织与账号 ----------------------------

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(64)
  code      String   @unique @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  patients Patient[]
  devices  Device[]
  /// 以本科室为入院科室的住院记录（R24）
  admissions Admission[]
  /// 科室停留记录（R24 转科轨迹）
  admissionDepartments AdmissionDepartment[]
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique @db.VarChar(64)
  /// 真实姓名（医护，非患者，院内可见，按需仍可选择加密）
  name               String     @db.VarChar(64)
  /// 工号 / 手机号加密存储
  phoneCipher        String?    @db.VarChar(512)
  passwordHash       String     @db.VarChar(255)
  status             UserStatus @default(ACTIVE)
  departmentId       String     @db.Uuid
  lastLoginAt        DateTime?
  /// 最近一次修改密码时间，用于密码有效期策略
  passwordChangedAt  DateTime   @default(now())
  /// 首次登录或被管理员重置后必须修改密码；为 true 时除改密/登出/个人信息的接口一律拒绝（20005）
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  department        Department             @relation(fields: [departmentId], references: [id])
  roles             UserRole[]
  bindings          PatientDeviceBinding[]
  /// 作为责任医生负责的患者
  patients          Patient[]              @relation("PatientDoctor")
  /// 作为责任护士负责的患者
  nursePatients     Patient[]              @relation("PatientNurse")
  /// 手工录入的血糖记录（作为记录者）
  glucoseRecords    GlucoseRecord[]        @relation("GlucoseOperator")
  /// 虚拟病区：由本人加入的进出记录
  wardJoinedRecords VirtualWardRecord[]    @relation("WardJoinedBy")
  /// 虚拟病区：由本人移出的进出记录
  wardLeftRecords   VirtualWardRecord[]    @relation("WardLeftBy")

  @@index([departmentId])
  @@index([status])
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(64)

  users UserRole[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------------- 患者 ----------------------------

/// 患者住院状态：决定患者管理页 Tab 与查询范围
enum PatientStatus {
  INPATIENT
  DISCHARGED
}

model Patient {
  id           String  @id @default(uuid()) @db.Uuid
  /// 住院号 / 门诊号（院内唯一业务主键）
  patientNo    String? @unique @db.VarChar(32)
  /// 姓名：密文 + 脱敏值（列表展示只用 Masked）
  nameCipher   String  @db.VarChar(512)
  nameMasked   String  @db.VarChar(64)
  idCardCipher String? @db.VarChar(512)
  idCardMasked String? @db.VarChar(64)
  phoneCipher  String? @db.VarChar(512)
  phoneMasked  String? @db.VarChar(32)

  /// 性别：取值见 @gc/shared GENDER（含 UNSPECIFIED 未说明，故长度 16）
  gender       String?       @db.VarChar(16)
  birthDate    DateTime?     @db.Date
  bedNo        String?       @db.VarChar(32)
  /// 糖尿病类型：取值见 @gc/shared DIABETES_TYPE
  diabetesType String?       @db.VarChar(32)
  /// 糖化血红蛋白（%），0~100，保留 1 位小数
  hba1c        Decimal?      @db.Decimal(4, 1)
  remark       String?       @db.VarChar(255)
  departmentId String        @db.Uuid
  /// 住院 / 出院状态（Tab 与列表接口按此过滤）
  status       PatientStatus @default(INPATIENT)
  /// 入院时间（筛选区间）
  admissionAt  DateTime?
  /// 出院时间（出院 Tab 筛选区间；为空表示仍在院）
  dischargeAt  DateTime?
  /// 责任医生
  doctorId     String?       @db.Uuid
  /// 责任护士
  nurseId      String?       @db.Uuid
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  department         Department             @relation(fields: [departmentId], references: [id])
  doctor             User?                  @relation("PatientDoctor", fields: [doctorId], references: [id])
  nurse              User?                  @relation("PatientNurse", fields: [nurseId], references: [id])
  bindings           PatientDeviceBinding[]
  glucoseRecords     GlucoseRecord[]
  /// 虚拟病区进出记录（含历史）；"当前是否在区" = 有没有 leftAt 为空的行
  virtualWardRecords VirtualWardRecord[]
  /// 住院记录（R24）：一行 = 一次住院；admissionAt/dischargeAt 上方旧字段保留双写（裁定 Q2）
  admissions          Admission[]
  /// 科室停留记录（R24）：跨全部住院的转科轨迹（冗余 patientId，裁定 Q3）
  admissionDepartments AdmissionDepartment[]

  @@index([departmentId, archivedAt])
  @@index([departmentId, status, admissionAt])
  @@index([doctorId])
  @@index([nurseId])
  @@index([nameMasked])
}

/// 住院记录（R24，2026-11-20 需求人评审通过，见 docs/specs/glucose-report-query.md §2.1）：
/// 一行 = 一次住院。seq = 第几次住院（患者内唯一，从 1 起）。dischargedAt NULL = 本次住院（在院）。
/// Patient.admissionAt/dischargeAt/status 旧字段**保留并双写**（裁定 Q2）：列表接口仍读旧字段，
/// 废弃旧字段属后续独立评审。写入口：建档（seq=1）、办理住院 admit()（seq=max+1）。
model Admission {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  /// 第几次住院（下拉 label「第N次」前缀的数据源，裁定 Q5）
  seq       Int
  /// 可空：兼容存量老数据（裁定 Q7，同 Patient.admissionAt 可空口径）
  admittedAt   DateTime? @db.Timestamptz(3)
  /// NULL = 在院（本次住院）
  dischargedAt DateTime? @db.Timestamptz(3)
  /// 入院科室（首科室；完整科室轨迹见 AdmissionDepartment）
  departmentId String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient         Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  department      Department            @relation(fields: [departmentId], references: [id])
  departmentStays AdmissionDepartment[]

  @@unique([patientId, seq])
  @@index([patientId, admittedAt(sort: Desc)])
}

/// 科室停留（R24 转科轨迹，见 docs/specs/glucose-report-query.md §2.2）：
/// 一行 = 一次住院中在某个科室的一段连续停留。endedAt NULL = 当前在科。
/// 「每次住院至多一条进行中」由**部分唯一索引**保证（Prisma 表达不了，
/// 见 prisma/sql/admission_one_active_department.sql，同 ward_one_active.sql 模式）。
/// 转科功能模块后续实现（R24 只落表结构）：转科 = 关闭旧行 endedAt + 开新行（同事务）。
model AdmissionDepartment {
  id          String @id @default(uuid()) @db.Uuid
  admissionId String @db.Uuid
  /// 冗余列（裁定 Q3）：按患者取全部科室记录免 join；删患者随 Cascade
  patientId    String   @db.Uuid
  departmentId String   @db.Uuid
  /// 可空：兼容 admittedAt 为空的存量数据（裁定 Q7）
  startedAt DateTime?  @db.Timestamptz(3)
  /// NULL = 当前在科
  endedAt   DateTime?  @db.Timestamptz(3)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  admission  Admission  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])

  @@index([admissionId, startedAt])
  @@index([patientId])
}

/// 患者最近血糖读取模型。后续血糖录入/查询模块可在此基础上扩展。
model GlucoseRecord {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  /// 结果类型，取值见 @gc/shared DICT_TYPE.GLUCOSE_RESULT（'0'~'9'）；0/2 由后台按阈值判定
  resultType  String   @db.VarChar(2)
  /// 血糖值，统一 mmol/L；非数值类型（3~9）为 null
  valueMmolL  Decimal? @db.Decimal(4, 1)
  /// 测量时段码，取值见 TimeSlot.code（动态数据）；录入时由服务端校验该 code 存在且 enabled
  mealContext String?  @db.VarChar(32)
  measuredAt  DateTime @db.Timestamptz(3)
  /// 记录者（录入人）；历史数据与设备自动上报可为空，手工录入由应用层强制必填
  operatorId  String?  @db.Uuid
  /// 试纸数量（张，整数）；仅检测类结果可填
  testStrip   Int?
  /// 备注，最长 500 字
  remark      String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  patient  Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// 记录者是医疗留痕，删用户不得抹掉录入人，因此显式 Restrict（与实库一致）。
  /// 对照 AuditLog.operatorId 干脆不建外键，同样是防止留痕随用户删除而失真。
  operator User?   @relation("GlucoseOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  /// 唯一约束兜底：同一患者同一检测时间只允许一条记录；重复提交由服务端按幂等返回 skipped=true
  @@unique([patientId, measuredAt])
  @@index([patientId, measuredAt(sort: Desc)])
  @@index([operatorId])
}

/// 虚拟病区进出记录：一条 = 一次进出。leftAt 为空表示当前在区，非空即历史。
/// 与 PatientDeviceBinding（unboundAt 为空 = 当前绑定）是同一套"单条有效 + 保留历史"模式。
/// 重复进出**每次新建记录**、历史全留（2026-11-18 需求人裁定），因此同一患者可有多条历史 + 至多一条在区。
/// "至多一条在区"由部分唯一索引保证，Prisma 表达不了，见 prisma/sql/ward_one_active.sql。
model VirtualWardRecord {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  /// 加入时间，「加入虚拟病区天数」的计算起点；业务时间故用 timestamptz（同 GlucoseRecord.measuredAt）
  joinedAt    DateTime  @default(now()) @db.Timestamptz(3)
  /// 移出时间；NULL = 当前仍在虚拟病区
  leftAt      DateTime? @db.Timestamptz(3)
  /// 加入操作人
  joinedById  String    @db.Uuid
  /// 移出操作人；leftAt 非空时必填（应用层保证）。库层可空，因为在区行还没有移出人
  leftById    String?   @db.Uuid
  /// 移出方式，取值见 @gc/shared WARD_LEAVE_REASON；在区时为 NULL。
  /// DISCHARGE / ARCHIVE 是预留值，待出院/归档功能落地时接入（docs/specs/virtual-ward.md §4-8）
  leaveReason String?   @db.VarChar(16)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patient  Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// 操作人是医疗留痕，删用户不得抹掉，因此显式 Restrict（与 GlucoseRecord.operator 同理）
  joinedBy User    @relation("WardJoinedBy", fields: [joinedById], references: [id], onDelete: Restrict)
  leftBy   User?   @relation("WardLeftBy", fields: [leftById], references: [id], onDelete: Restrict)

  /// 按患者取在区记录（列表 inVirtualWard 子查询、加入前的重复校验都走它）
  @@index([patientId, leftAt])
  /// 当前/历史两个 Tab 的排序与日期区间筛选
  @@index([leftAt, joinedAt])
  @@index([joinedById])
  @@index([leftById])
}

// ---------------------------- 设备 ----------------------------

enum DeviceStatus {
  /// 未绑定患者
  IDLE
  /// 已绑定患者且使用中
  BOUND
  /// 超过约定时长未上报（由定时任务或查询时计算）
  OFFLINE
  /// 停用/报废
  DISABLED
}

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  sn              String       @unique @db.VarChar(64)
  model           String       @db.VarChar(64)
  manufacturer    String?      @db.VarChar(64)
  firmwareVersion String?      @db.VarChar(32)
  status          DeviceStatus @default(IDLE)
  enabled         Boolean      @default(true)
  /// 最后一次上报时间，设备在线状态判断依据
  lastReportAt    DateTime?
  calibratedAt    DateTime?
  departmentId    String?      @db.Uuid
  /// 设备台账：采购与保修，用于设备生命周期管理
  purchasedAt     DateTime?
  warrantyUntil   DateTime?
  remark          String?      @db.VarChar(255)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  department Department?            @relation(fields: [departmentId], references: [id])
  bindings   PatientDeviceBinding[]

  @@index([status, enabled])
  @@index([departmentId])
}

model PatientDeviceBinding {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @db.Uuid
  deviceId   String    @db.Uuid
  boundAt    DateTime  @default(now())
  unboundAt  DateTime?
  operatorId String?   @db.Uuid

  patient  Patient @relation(fields: [patientId], references: [id])
  device   Device  @relation(fields: [deviceId], references: [id])
  operator User?   @relation(fields: [operatorId], references: [id])

  /// 同一台设备在同一时间只能绑定一个有效患者（partial unique 在 SQL 层补充）
  @@unique([deviceId, boundAt])
  @@index([patientId, unboundAt])
  @@index([deviceId, unboundAt])
}

// ---------------------------- 审计与配置 ----------------------------

/// 审计动作。
/// 顺序与取值**必须与实库 pg_enum 一致**：AuditLog 只增不改不删（留存 >= 180 天），
/// 重建枚举类型会让引用了历史值的旧行转换失败并整事务回滚，因此这里向实库靠拢，不重排。
enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PATIENT_VIEW
  PATIENT_MANAGE
  /// 以下 3 个是 P3 血糖模块 2026-10-22 移除前写入的历史值，实库仍有旧审计行引用。
  /// 保留只为能读出旧记录，**新代码禁止使用**（血糖动作统一用 GLUCOSE_CREATE）。
  GLUCOSE_VIEW
  GLUCOSE_INPUT
  GLUCOSE_EXPORT
  DEVICE_VIEW
  DEVICE_MANAGE
  USER_MANAGE
  DATA_EXPORT
  PASSWORD_CHANGE
  /// 患者建档（新增患者），与 PATIENT_MANAGE 区分，便于审计按动作过滤
  PATIENT_CREATE
  /// 患者信息编辑（改床号/责任医生等），detail.changedFields 记变更字段名
  PATIENT_UPDATE
  /// 添加血糖（手工录入血糖记录），detail 记 resultType / valueMmolL / testStrip / measuredAt / skipped
  GLUCOSE_CREATE
  /// 加入虚拟病区，detail 记 patientId / wardRecordId（targetId 已是患者 ID）
  PATIENT_WARD_JOIN
  /// 移出虚拟病区，detail 记 patientId / wardRecordId / leaveReason
  PATIENT_WARD_REMOVE
  /// 血糖报告查询（GET /patients/:id/glucose/report），detail 记 rangeFrom / rangeTo / count。
  /// ⚠️ 缺陷补登记（R24 迁移）：该动作 2026-11-19 上线时 @Audit 已在用，但枚举漏登记，
  /// PG 拒绝非法枚举值 → 审计行实际从未落表（拦截器吞错只打 console.error）。
  GLUCOSE_REPORT_VIEW
  /// 住院记录查询（GET /patients/:id/admissions，R24），detail 无患者敏感信息
  ADMISSION_QUERY
}

/// 审计日志：只增不改不删，留存 >= 180 天（等保三级要求）
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  operatorId   String? @db.Uuid
  operatorName String? @db.VarChar(64)
  /// 快照操作人科室，便于事后按科室追溯
  departmentId String? @db.Uuid

  action AuditAction

  /// 对象类型，如 PATIENT / DEVICE / AUDIT
  targetType String? @db.VarChar(32)
  targetId   String? @db.Uuid
  /// 非 UUID 对象的业务主键（如登录用户名），用于失败锁定统计
  targetKey  String? @db.VarChar(64)

  ip        String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  /// SUCCESS / DENIED / FAILED
  result String @db.VarChar(16)
  detail Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([operatorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, targetKey, createdAt])
}

/// 系统配置（告警阈值等，禁止硬编码在业务代码里）
model SystemConfig {
  key         String   @id @db.VarChar(64)
  value       String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt
}

/// 动态字典（公共数据）：登录后一次性下发，前端 useCommonDataStore 缓存。
/// 字典是数据不是代码：新增/调整取值改数据即可，不再发版；前端禁止硬编码 label/color。
model DictItem {
  id        String  @id @default(uuid()) @db.Uuid
  /// 字典类型，取值见 @gc/shared 的 DICT_TYPE（如 GLUCOSE_RESULT）
  dictType  String  @db.VarChar(32)
  /// 字典码：入库与接口传输用；血糖监测结果为 '0'~'9'
  code      String  @db.VarChar(32)
  /// 展示文案（中文或英文标签，如 偏低 / Low / 拒检）
  label     String  @db.VarChar(64)
  /// 展示色，前端直接取用；色值登记见 docs/UI-DESIGN-TOKENS.md 5.1
  color     String? @db.VarChar(16)
  /// 是否可由用户选择：偏低/偏高由后台按阈值判定，不出现在录入选项里
  checkable Boolean @default(true)
  /// 是否计入血糖统计（拒检/外出/请假/已吃饭/未进食不计入）
  counted   Boolean @default(true)
  /// 同类型内展示顺序，升序
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dictType, code])
  @@index([dictType, sortOrder])
}

/// 时段（原 D-TIMESLOT 静态字典，改为动态数据）。
/// 血糖按 measuredAt 落入 [startTime, endTime) 归组；普通时段要求 00:00~24:00 全覆盖、不重叠、不跨零点，
/// 特殊时段（随机/复测）与强化时段无区间。code 是落库契约（GlucoseRecord.mealContext），改名不改码。
model TimeSlot {
  id        String   @id @default(uuid()) @db.Uuid
  /// 时段码，落库值：FASTING / BREAKFAST_PRE / RANDOM ...
  code      String   @unique @db.VarChar(32)
  /// 时段名，展示用
  name      String   @db.VarChar(64)
  /// 0-强化 1-普通 4-特殊，取值见 @gc/shared TIME_SLOT_CATEGORY
  type      Int
  /// 起点 HH:mm（'24:00' 可作终点）；特殊/强化为空
  startTime String?  @db.VarChar(5)
  /// 终点 HH:mm；特殊/强化为空
  endTime   String?  @db.VarChar(5)
  /// 时段控糖目标下限 mmol/L；特殊/强化为空
  valueDown Decimal? @db.Decimal(4, 1)
  /// 时段控糖目标上限 mmol/L；特殊/强化为空
  valueUp   Decimal? @db.Decimal(4, 1)
  /// 展示顺序，升序；普通在前、特殊居中、强化在后
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, sortOrder])
}
